# TotalChat .env.example

APP_ENV=development
APP_BASE_URL=https://totalchat.example.com
LOG_LEVEL=INFO

DATABASE_URL=postgresql+psycopg://totalchat:totalchat@postgres:5432/totalchat
REDIS_URL=redis://redis:6379/0

JWT_SECRET=change-me
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

TOTALCHAT_LLM_PROVIDER=openai
TOTALCHAT_LLM_MODEL=gpt-5-mini
TOTALCHAT_EMBEDDINGS_PROVIDER=openai
TOTALCHAT_EMBEDDINGS_MODEL=text-embedding-3-small
OPENAI_API_KEY=

TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

WOMPI_PUBLIC_KEY=
WOMPI_PRIVATE_KEY=
WOMPI_EVENTS_SECRET=
